{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigsep.org/schemas/antenna-resolution-policy-v1.json",
  "title": "EIGSEP physical-antenna resolution policy",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "name", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "campaign": {"type": "string"},
    "description": {"type": "string"},
    "provenance": {"type": "object"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "match"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["use", "reject"]},
          "match": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          },
          "reason": {"type": "string", "minLength": 1},
          "inputs": {
            "type": "object",
            "additionalProperties": {"type": "string"},
            "minProperties": 1
          },
          "crosses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["antennas", "key", "conjugated"],
              "properties": {
                "antennas": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "string"},
                    {"type": "string"}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "key": {"type": "string"},
                "conjugated": {"type": "boolean"}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "use"}}},
            "then": {"required": ["inputs", "crosses"]}
          },
          {
            "if": {"properties": {"status": {"const": "reject"}}},
            "then": {"required": ["reason"]}
          }
        ]
      }
    }
  }
}
